{
  "name": "tulka-samvaer-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=development",
    "mock": "ng serve --configuration=mock",
    "mock:api": "node mock-api/server.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "compodoc": "compodoc -p tsconfig.doc.json",
    "test:mock": "node --test mock-api/server.test.mjs",
    "api:lint": "redocly lint api/openapi.yaml",
    "api:types": "npx -y openapi-typescript@7.13.0 api/openapi.yaml -o src/app/core/api/schema.d.ts"
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/entity": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@compodoc/compodoc": "^2.0.0",
    "@ngrx/schematics": "^22.0.1",
    "@redocly/cli": "^2.82.0",
    "@types/node": "^22.15.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^29.0.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
